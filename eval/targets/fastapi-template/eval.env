# Synthetic settings for the local eval containers only. These are not secrets:
# they never leave Docker on your machine, and the login appears in recordings
# (task 1.8) by design. They replace the template's "changethis" defaults.
PROJECT_NAME="Full Stack FastAPI Project"
SECRET_KEY=eval-only-not-a-secret-signing-key-0000
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=eval-only-not-a-secret
POSTGRES_PASSWORD=eval-only-not-a-secret
# Empty SMTP_HOST disables email, so nothing tries to send mail.
SMTP_HOST=
EMAILS_FROM_EMAIL=info@example.com
